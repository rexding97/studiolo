# 复制为 .env 后修改；不要将真实密码提交到版本库
REXHUB_INIT_PASSWORD=change-me
REXHUB_USER=admin
REXHUB_BIND_HOST=127.0.0.1
REXHUB_PORT=3002
STUDIOLO_IMAGE_TAG=0.1.3
TZ=Asia/Shanghai

# 可选 CalDAV Basic 凭据：组件 ID calendar-work 对应以下键名。
# 非字母数字统一转为 _ 并大写；两项必须同时配置，不会随 YAML 导出。
# Docker Compose 还需在 services.studiolo.environment 显式转发同名变量。
# REXHUB_CALDAV_CALENDAR_WORK_USERNAME=
# REXHUB_CALDAV_CALENDAR_WORK_PASSWORD=

# 国内构建可改用镜像源
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
